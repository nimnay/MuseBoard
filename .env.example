# Everything here is optional: with no keys at all, MuseBoard reads public boards
# via RSS and tags images locally with CLIP. Add keys to unlock more.

# Gemini (free tier at https://aistudio.google.com/apikey) — richer tagging + strategies
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Groq — alternative LLM provider, used when GEMINI_API_KEY is unset
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Force a provider instead of auto-detecting: gemini | groq | local
# MUSEBOARD_PROVIDER=

# Pinterest API v5 token — only needed for --source api (boards your account owns)
PINTEREST_ACCESS_TOKEN=

# Notion — set both to export each theme as a database page
NOTION_API_KEY=
NOTION_DATABASE_ID=
